{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-frozen-writes.sh"],
            "timeout": 10,
            "statusMessage": "Checking the file is not frozen"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.sh"],
            "timeout": 10,
            "statusMessage": "Checking the command against the project rules"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh"],
            "timeout": 10,
            "statusMessage": "Loading docs/STATE.md"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/check-state-stamp.sh"],
            "timeout": 10,
            "statusMessage": "Checking docs/STATE.md is stamped"
          }
        ]
      }
    ]
  }
}
